generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum EnquiryStatus {
  NEW
  CONTACTED
  CLOSED
}

model Enquiry {
  id            String        @id @default(cuid())
  name          String
  email         String
  phone         String
  property      String
  checkIn       DateTime?
  checkOut      DateTime?
  guests        Int?
  message       String
  status        EnquiryStatus @default(NEW)
  userIp        String?
  legacyTicket  String?
  createdAt     DateTime      @default(now())

  @@index([createdAt])
  @@index([property])
}

model Voucher {
  id                  String    @id @default(cuid())
  voucherNo           Int       @unique @default(autoincrement())
  viewToken           String    @unique

  hotelSlug           String

  guestName           String
  guestPhone          String
  guestEmail          String
  billingAddress      String

  travelAgentName     String?
  travelAgentPan      String?
  travelAgentGstin    String?
  travelAgentState    String?
  commissionPct       Decimal?  @db.Decimal(5, 2)
  tdsPct              Decimal?  @db.Decimal(5, 2)

  rooms               Int
  checkIn             DateTime
  checkOut            DateTime
  rate                Decimal   @db.Decimal(10, 2)
  taxes               Decimal   @db.Decimal(10, 2)

  depositAmount       Decimal?  @db.Decimal(10, 2)
  depositReceiptNo    String?
  depositReceiptDate  DateTime?

  billingInstructions String?
  arrivalDetails      String?
  otherServices       String?
  specialInstructions String?

  issuerName          String
  issuerPhone         String
  bookingOffice       String

  legacyId            Int?

  createdAt           DateTime  @default(now())

  @@index([hotelSlug])
  @@index([createdAt])
}

model Newsletter {
  id             String    @id @default(cuid())
  email          String    @unique
  ip             String?
  subscribedAt   DateTime  @default(now())
  unsubscribedAt DateTime?
}

enum PaymentStatus {
  INITIATED
  SUCCESS
  FAILURE
  ABORTED
}

// One row per i-Pay attempt, created before the guest is redirected to
// CCAvenue and updated only from CCAvenue's own encrypted callback — never
// from a plain redirect query param, which anyone could forge.
model Payment {
  id             String        @id @default(cuid())
  orderId        String        @unique
  hotelSlug      String
  amount         Decimal       @db.Decimal(10, 2)
  guestName      String
  guestEmail     String
  guestPhone     String
  billingAddress String?
  remark         String?
  reservationNo  String?
  checkIn        DateTime?
  checkOut       DateTime?
  status         PaymentStatus @default(INITIATED)
  trackingId     String?
  bankRefNo      String?
  failureMessage String?
  userIp         String?
  createdAt      DateTime      @default(now())
  updatedAt      DateTime      @updatedAt

  @@index([hotelSlug])
  @@index([createdAt])
}
