generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum EnquiryStatus {
  NEW
  CONTACTED
  CLOSED
}

model Enquiry {
  id         String        @id @default(cuid())
  name       String
  email      String
  phone      String
  property   String
  checkIn    DateTime?
  checkOut   DateTime?
  guests     Int?
  message    String
  status     EnquiryStatus @default(NEW)
  createdAt  DateTime      @default(now())

  @@index([createdAt])
  @@index([property])
}
