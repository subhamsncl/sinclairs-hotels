DATABASE_URL="postgresql://sinclairs:sinclairs_dev@localhost:5432/sinclairs_hotels"

# sinclairshotels.com still serves the old WordPress site (see lib/site-url.ts),
# so absolute URLs built for emails (logo image, voucher view links) must point
# here instead, or they 404 against the wrong site. Remove once the real domain
# cuts over to this app.
SITE_BASE_URL=https://sinclairs-hotels.vercel.app

RESEND_API_KEY=
# Custom "from" address once sinclairshotels.com is verified at
# https://resend.com/domains. Until then, lib/mail.ts falls back to Resend's
# onboarding@resend.dev sender, which needs no verification.
MAIL_FROM_ADDRESS=
# Where staff-facing notifications (enquiry, newsletter signup, voucher office copy,
# daily digest) go. Also who every outbound email is Bcc'd to, if set.
STAFF_NOTIFY_EMAIL=
OWNER_BCC_EMAIL=
# Pre-launch safety valve: when set, every outbound email (voucher guest/office
# copies, enquiry notifications, i-Pay confirmations) is redirected here instead
# of the real guest/hotel address, with the original recipient kept in the
# subject line. Unset once real guests/hotels should actually receive mail.
MAIL_RECIPIENT_OVERRIDE=
ADMIN_SESSION_SECRET=
ADMIN_PASSWORD=

# Authenticates the daily digest cron endpoint — Vercel sends this same value as
# the Authorization: Bearer header when it calls scheduled routes.
CRON_SECRET=
# Who the daily digest email goes to (legacy: Ravi's Gmail, with admin@ Bcc).
DIGEST_TO_EMAIL=
DIGEST_BCC_EMAIL=

# CCAvenue (i-Pay) — Merchant ID is not secret (visible in the legacy page's
# own HTML), but Working Key and Access Code must come from the CCAvenue
# merchant dashboard and never be committed.
CCAVENUE_MERCHANT_ID=2006182
CCAVENUE_WORKING_KEY=
CCAVENUE_ACCESS_CODE=
